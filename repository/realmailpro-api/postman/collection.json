                },
                "description": "Creates a 10-minute inbox. 1 credit (alias) or 3 credits (original). service: gmail_alias | outlook_alias | gmail_original | outlook_original.\n\nSource: https://realmailpro.online/docs",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"service\": \"gmail_alias\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{ \"id\": \"8f1c…\", \"address\": \"name+abc@outlook.com\", \"expires_at\": \"…\", \"created_at\": \"…\" }"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) pm.collectionVariables.set('inboxId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
