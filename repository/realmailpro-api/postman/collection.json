  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://realmailpro.online/api/public/v1"
    },
    {
      "key": "apiKey",
      "value": "YOUR_API_KEY",
      "type": "secret"
    },
    {
      "key": "inboxId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    }
  ],
