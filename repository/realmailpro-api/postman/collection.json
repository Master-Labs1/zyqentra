            ],
            "url": {
              "raw": "{{baseUrl}}/account/balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "account",
                "balance"
              ]
            },
            "description": "Wallet balance in credits. Free — use it to confirm your key works.\n\nSource: https://realmailpro.online/docs"
